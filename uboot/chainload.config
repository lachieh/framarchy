# Mainline U-Boot proper, started by the frame's stock Rockchip U-Boot as if
# it were a Linux kernel (booti), to boot our kernel with our own DTB.
# Stock U-Boot has already initialised DRAM, clocks and PMIC rails, so this
# build must not touch power or storage state.

# Packaged as an arm64 Linux Image (header magic "ARMd"), runnable anywhere.
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_OF_EMBED=y
# CONFIG_OF_SEPARATE is not set

# No voltage changes: leave the RK809 rails exactly as stock U-Boot set them.
# CONFIG_DM_PMIC is not set
# CONFIG_PMIC_RK8XX is not set
# CONFIG_DM_REGULATOR_GPIO is not set
# CONFIG_REGULATOR_RK8XX is not set
# CONFIG_REGULATOR_PWM is not set
# CONFIG_DM_REGULATOR_FIXED is not set

# Never write the eMMC: no saved environment.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_SUPPORT_EMMC_RPMB is not set

# Nothing that is not needed to read the SD card / eMMC.
# CONFIG_VIDEO is not set
# CONFIG_DISPLAY is not set
# CONFIG_SOUND is not set
CONFIG_NO_NET=y
# CONFIG_ETH_DESIGNWARE is not set
# CONFIG_GMAC_ROCKCHIP is not set
# USB core is needed for the gadget (fastboot) below; no host controllers.
CONFIG_USB=y
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_EHCI_GENERIC is not set
# CONFIG_CMD_USB is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_DEBUG_UART is not set

# Boot the SD card's extlinux.conf. If nothing
# boots, become a USB fastboot device (read-only: no flashing) so the host can
# read this U-Boot's console with "fastboot oem console" and run commands with
# "fastboot oem run:<cmd>". "fastboot reboot" returns to stock U-Boot/Android.
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
# sysboot reads exactly the SD card's first partition (mmc 1 = sdmmc here);
# "bootflow scan -lb" needs BOOTSTD_FULL and fails without it.
CONFIG_BOOTCOMMAND="sysboot mmc 1:1 any ${scriptaddr} /extlinux/extlinux.conf; fastboot usb 0"
CONFIG_CMD_SYSBOOT=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x20000
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DWC2_OTG=y
CONFIG_PHY=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
# Own product ID: the default 2207:330d is stock Loader mode's, which the
# test script would mistake for Loader and reset.
CONFIG_USB_GADGET_PRODUCT_NUM=0x0157
# CONFIG_FASTBOOT_FLASH is not set
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y
