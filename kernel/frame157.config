# Built-in requirements for the FRAME157 RAM-only first boot.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
# CONFIG_USB_CONFIGFS_NCM is not set
# CONFIG_USB_G_SERIAL is not set

# Crash log in RAM at the stock ramoops address, readable from stock Android
# after a warm reboot (see docs/boot-evidence.md).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Display: VOP -> DSI -> Lontium LT8911EXB (DSI to eDP) -> panel, PWM backlight.
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=m
CONFIG_DRM_LONTIUM_LT8911EXB=m
CONFIG_DRM_PANEL_SIMPLE=m
CONFIG_DRM_PANFROST=m
CONFIG_PWM_ROCKCHIP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=m

# Touch (Silead GSL3676 at i2c-1 0x40).
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_UINPUT=m
CONFIG_TOUCHSCREEN_SILEAD=m

# Board: RTC, audio codec in the RK809.
CONFIG_RTC_DRV_HYM8563=m
CONFIG_SND_SOC_ROCKCHIP_I2S=m
CONFIG_SND_SOC_RK817=m

# USB networking to the host (CDC-NCM) next to the ACM console.
CONFIG_USB_CONFIGFS_NCM=y

# Low-RAM: zram swap.
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y

# RK915 Wi-Fi (out-of-tree driver, see scripts/build-rk915.sh): power sequence
# with a single reset-gpios line, and mac80211.
CONFIG_RESET_GPIO=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
